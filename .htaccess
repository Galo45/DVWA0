<IfModule mod_headers.c>
    # 1. Content Security Policy (CSP) - con directivas de respaldo completas
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"

    # 2. Anti-Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # 3. Prevenir MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # 4. Control de Referrer (evita fuga de informacion)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 5. Eliminar cabeceras que revelan informacion del servidor
    Header always unset X-Powered-By
    Header always unset Server
    Header always unset X-AspNet-Version

    # 6. HttpOnly + SameSite en TODAS las cookies
    Header always edit Set-Cookie "^(.*)$" "$1; HttpOnly; SameSite=Lax"
</IfModule>

# 7. Ocultar firma y version del servidor Apache
ServerSignature Off
ServerTokens Prod
